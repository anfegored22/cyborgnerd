[Unit]
Description=CyborgNerd portfolio
After=network.target

[Service]
Type=simple
User=cyborgnerd
Group=cyborgnerd
WorkingDirectory=/opt/cyborgnerd
ExecStart=/opt/cyborgnerd/cyborgnerd
Environment=HTTP_ADDR=127.0.0.1:8080
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
